# Application
APP_NAME="Landing Zone Portal"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landing_zone_portal
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Azure AD OAuth (optional)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_ENABLED=false

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ENABLED=false

# Deployment Platform (spacelift or github_actions)
DEPLOYMENT_PLATFORM=spacelift

# Spacelift Configuration
SPACELIFT_API_KEY_ENDPOINT=
SPACELIFT_API_KEY_ID=
SPACELIFT_API_KEY_SECRET=
SPACELIFT_ENDPOINT=https://example.app.spacelift.io

# GitHub Configuration
GITHUB_TOKEN=
GITHUB_ORGANIZATION=
GITHUB_REPOSITORY=

# Azure Configuration
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Cost Management
AZURE_COST_MANAGEMENT_ENABLED=false
COST_UPDATE_INTERVAL_MINUTES=60

# Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
EMAIL_ENABLED=false

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
